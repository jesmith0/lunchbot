# Copy to .env and fill in. Never commit .env: it will hold chat tokens.
# Run with:  uv run --env-file .env lunchbot serve   (or post-lunch, close-voting)

# Directory holding restaurants.txt, drivers.txt and vetos.txt.
# Defaults to the data/ folder in this repo. Relative paths resolve
# against the current working directory.
LUNCHBOT_DATA_DIR=

# Where the scheduled post-lunch / close-voting jobs post: console or slack.
LUNCHBOT_PLATFORM=console

# --- Slack (see the "Slack setup" section of the README) ---
# Bot token from OAuth & Permissions (xoxb-...)
SLACK_BOT_TOKEN=
# Channel ID for the daily lunch post (right-click the channel > View channel details)
LUNCHBOT_SLACK_CHANNEL=
# Socket Mode (`lunchbot serve`): app-level token with connections:write (xapp-...)
SLACK_APP_TOKEN=
# HTTP mode (lunchbot.wsgi): Signing Secret from Basic Information
SLACK_SIGNING_SECRET=
