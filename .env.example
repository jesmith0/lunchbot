# Copy to .env and fill in. Never commit .env: webhook URLs contain auth tokens.
# Run with:  uv run --env-file .env python lunchbot.py

# Directory holding restaurants.txt, drivers.txt and vetos.txt.
# Defaults to the data/ folder next to lunchbot.py. Relative paths resolve
# against the current working directory.
LUNCHBOT_DATA_DIR=

# Webhook the bot posts to. Used for every room without an override below.
LUNCHBOT_WEBHOOK_URL=

# Optional per-room overrides, as a JSON object of room name -> webhook URL.
# LUNCHBOT_ROOM_WEBHOOKS={"The Force Awakens": "https://...", "Rogue One": "https://..."}
LUNCHBOT_ROOM_WEBHOOKS=
